            "reviewId": {
                "title": "Review ID",
                "description": "The unique ID for the product review.",
                "type": "string"
            },
            "reviewUserNickname": {
                "title": "Review User Nickname",
                "description": "The displayed nickname for the author of the review.",
                "type": "string"
            },
            "reviewRating": {
                "title": "Review Rating",
                "description": "The rating value.",
                "type": "integer",
                "minimum": 1,
                "maximum": 5
            },
            "reviewRatingRange": {
                "title": "Review Rating Range",
                "description": "The maximum possible rating (currently 5 on Adidas).",
                "type": "integer"
            },
            "reviewTitle": {
                "title": "Review Title",
                "description": "The title of the review.",
                "type": "string"
            },
            "reviewSubmissionTime": {
                "title": "Review Submission Time",
                "description": "A timestamp of the date and time in which the review was submitted, in UTC timezone.",
                "type": "string",
                "example": "2026-08-08T09:02:07.000+00:00"
            },
            "reviewText": {
                "title": "Review Text",
                "description": "The main text content of the review.",
                "type": ["string", "null"]
            },
            "reviewLikes": {
                "title": "Review Likes",
                "description": "The number of people who liked the review (clicked on the like button).",
                "type": "integer",
                "minimum": 0
            },
            "reviewDislikes": {
                "title": "Review Dislikes",
                "description": "The number of people who disliked the review (clicked the dislike button).",
                "type": "integer",
                "minimum": 0
            },
            "reviewProductColor": {
                "title": "Review Product Color",
                "description": "The color of the specific variant the review is referring to.",
                "type": "string"
            },
            "userRecommendsProduct": {
                "title": "User Recommends Product",
                "description": "Whether the user recommends this product.",
                "type": "boolean"
            },
            "questionsAnsweredFromReview": {
                "title": "Questions Answered from Review",
                "description": "The demographic questions that were answered from this review (internal Adidas metric).",
                "type": "array",
                "items": {
                    "type": "object",
                    "properties": {
                        "question": {
                            "title": "Question",
                            "description": "The question.",
                            "type": "string"
                        },
                        "answer": {
                            "title": "Answer",
                            "description": "The answer.",
                            "type": "string"
                        }
                    }
                }
            },
            "reviewImages": {
                "title": "Review Images",
                "description": "A list of the URLs of any images provided in the review by the user (e.g. a torn shoe).",
                "type": "array",
                "items": { "type": "string" },
                "example": [
                    "https://photos-eu.bazaarvoice.com/photo/2/cGhvdG86YWRpZGFzZ2xvYmFs/7aa45684-bd38-52c4-8fa7-c2418fc94e0f",
                    "https://photos-eu.bazaarvoice.com/photo/2/cGhvdG86YWRpZGFzZ2xvYmFs/28795c50-4c20-5e70-a86f-d0fcbbd17350"
                ]
            },
            "reviewBadges": {
                "title": "Review Badges",
                "description": "The displayed descriptive badges under the review.",
                "type": "array",
                "items": { "type": "string" },
                "example": [
                    "VerifiedPurchaser",
                    "IncentivizedReview"
                ]
            },
            "reviewLocale": {
                "title": "Review Locale",
                "description": "The country locale of the author of the review.",
                "type": "string",
                "example": "en_US"
            }
        },
        "required": [
            "scrapedAt",
            "dataType",
            "productId",
            "productName",
            "productUrl",
            "productModelNumber"
        ]
    },
