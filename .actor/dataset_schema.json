                "example": [
                    "https://assets.adidas.com/images/w_1200,f_auto,q_auto/1a0f638dc9ce4dc9b2518ee093450794_9366/Courtflash_Tennis_Shoes_Kids_Blue_KK3857_HM1.jpg",
