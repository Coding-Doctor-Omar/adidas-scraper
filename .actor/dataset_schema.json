{
    "$schema": "https://apify.com/schemas/v1/dataset.ide.json",
    "actorSpecification": 1,
    "fields": {
        "type": "object",
        "properties": {
            "scrapedAt": {
                "title": "Scraped At",
                "description": "A timestamp representing the date and time this data was scraped, in UTC timezone.",
                "type": "string",
                "example": "2026-10-01T09:29:10.804307+00:00"
            },
            "dataType": {
                "title": "Data Type",
                "description": "Whether this item is a product or a review.",
                "type": "string",
                "options": ["product", "review"]
            },
            "productId": {
                "title": "Product ID",
                "description": "The unique ID of the product (present in both product and review items).",
                "type": "string"
            },
            "productName": {
                "title": "Product Name",
                "description": "The display title of the product (present in both product and review items).",
                "type": "string"
            },
            "productUrl": {
                "title": "Product URL",
                "description": "The direct link to the product page (present in both product and review items).",
                "type": "string",
                "example": "https://www.adidas.com/us/courtflash-tennis-shoes-kids/KK3857.html"
            },
            "productModelNumber": {
                "title": "Product Model Number",
                "description": "The model number of the product (present in both product and review items).",
                "type": "string"
            },
            "productDescription": {
                "title": "Product Description",
                "description": "The displayed product description on Adidas.",
                "type": ["string", "null"]
            },
            "productThirdPartyOptions": {
                "title": "Product 3rd Party Options",
                "description": "Available 3rd party buy options for this product.",
                "type": "array",
                "items": { "type": "string" },
                "example": ["PRIME"]
            },
            "productRating": {
                "title": "Product Rating",
                "description": "The product rating out of 5 (will be 0 for unrated products).",
                "type": "number"
            },
            "productReviewCount": {
                "title": "Product Review Count",
                "description": "The total number of written reviews for the product in the same language as the default language of the selected country website.",
                "type": "integer"
            },
            "productSentiments": {
                "title": "Product Sentiments",
                "description": "AI-generated general sentiments for the product, based on the reviews (DISCLAIMER: These sentiments are scraped directly from Adidas, not generated by the developer of the Actor).",
                "type": "array",
                "items": { "type": "string" },
                "example": [
                    "Customers consistently praise lightweight, cushioned comfort with perfect true-to-size fit and no break-in needed",
                    "Most highlight durable, high-quality construction withstanding heavy daily use on hard courts and clay surfaces",
                    "Reviewers appreciate flexible, grippy soles suited for multiple court types and active play",
                    "Many call the modern, stylish design beautiful and eye-catching while maintaining timeless appeal",
                    "Customers emphasize exceptional value for quality, with strong intent to repurchase and recommend"
                ]
            },
            "productBadges": {
                "title": "Product Badges",
                "description": "The badges for this product as displayed on the Adidas website.",
                "type": "array",
                "items": { "type": "string" },
                "example": [
                    "Best Seller"
                ]
            },
            "productPrice": {
                "title": "Product Price",
                "description": "The current listing price of the product.",
                "type": ["number", "null"]
            },
            "productOriginalPrice": {
                "title": "Product Original Price",
                "description": "The original (undiscounted) price of the product (will be the same as the product price if there is no discount).",
                "type": ["number", "null"]
            },
            "productDiscountPercentage": {
                "title": "Product Discount (%)",
                "description": "The product discount percentage.",
                "type": "number"
            },
            "productPriceCurrency": {
                "title": "Product Price Currency",
                "description": "The price currency of the displayed price of the product, in letter format.",
                "type": "string",
                "example": "USD"
            },
            "productAvailability": {
                "title": "Product Availability",
                "description": "The total stock count of the product (this color variant).",
                "type": "integer"
            },
            "productAvailabilityStatus": {
                "title": "Product Availability Status",
                "description": "A simple status that describes whether the product is in stock or not available.",
                "type": "string",
                "options": ["IN_STOCK", "NOT_AVAILABLE"]
            },
            "productPurchaseLimit": {
                "title": "Product Purchase Limit",
                "description": "The purchase limit of the product (not the same as availability).",
                "type": "integer"
            },
            "productColor": {
                "title": "Product Color",
                "description": "The color of the product.",
                "type": "string"
            },
            "productCategory": {
                "title": "Product Category",
                "description": "The category of the product.",
                "type": "string"
            },
            "productCategorySlug": {
                "title": "Product Category Slug",
                "description": "The URL slug for the product category.",
                "type": "string",
                "example": "us/kids-shoes"
            },
            "productGender": {
                "title": "Product Gender",
                "description": "The product gender.",
                "type": "string",
                "options": [
                    "men",
                    "women",
                    "kids",
                    "unisex"
                ]
            },
            "productTotalColors": {
                "title": "Product Total Colors",
                "description": "The total colors (color variants) available for this product.",
                "type": "integer"
            },
            "productVariants": {
                "title": "Product Variants",
                "description": "A list of the available color variants of the product, including the product itself. Inside each color variant, there is another list of the different size variations available for this color variant.",
                "type": "array",
                "items": {
                    "type": "object",
                    "properties": {
                        "variantId": {
                            "title": "Variant ID",
                            "description": "The ID of the color variant.",
                            "type": ["string", "null"]
                        },
                        "variantUrl": {
                            "title": "Variant URL",
                            "description": "The URL for the color variant product page.",
                            "type": ["string", "null"]
                        },
                        "variantColor": {
                            "title": "Variant Color",
                            "description": "The variant color.",
                            "type": "string"
                        },
                        "variantSizeVariations": {
                            "title": "Variant Size Variations",
                            "description": "The size variants of the color variant.",
                            "type": "array",
                            "items": {
                                "type": "object",
                                "properties": {
                                    "sku": {
                                        "title": "SKU",
                                        "description": "The size variant SKU.",
                                        "type": "string"
                                    },
                                    "availability": {
                                        "title": "Availability",
                                        "description": "The size variant availability.",
                                        "type": "integer"
                                    },
                                    "availabilityStatus": {
                                        "title": "Availability Status",
                                        "description": "Whether the size variant is in stock or not available.",
                                        "type": "string",
                                        "options": ["IN_STOCK", "NOT_AVAILABLE"]
                                    },
                                    "size": {
                                        "title": "Size",
                                        "description": "The size label of the size variant.",
                                        "type": "string",
                                        "example": "5.5"
                                    }
                                }
                            },
                            "example": {
                                "sku": "KH8537_550",
                                "availability": 0,
                                "availabilityStatus": "NOT_AVAILABLE",
                                "size": "5"
                            }
                        }
                    }
                },
                "example": {
                    "variantId": "KK3857",
                    "variantUrl": "https://www.adidas.com/us/courtflash-tennis-shoes-kids/KK3857.html",
                    "variantColor": "Dark Blue / Cloud White / Bright Blue",
                    "variantSizeVariations": [
